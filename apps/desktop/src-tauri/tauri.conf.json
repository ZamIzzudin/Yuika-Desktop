{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Yuika",
  "version": "0.1.0",
  "identifier": "com.zamizzudin.yuika",
  "build": {
    "beforeDevCommand": "node ../../scripts/dev-web.mjs",
    "beforeBuildCommand": "node ../../scripts/build-desktop-web.mjs",
    "devUrl": "http://localhost:3000",
    "frontendDist": "../../../dist/web"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Yuika",
        "url": "welcome.html",
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 640
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEQ0RjNFMzk0OENGRDYxNEQKUldSTllmMk1sT1B6MU0ydWNoSzJNajdnMUJ3SDNVSXFwTFl1aG95NGxTSTI3UUlJdGx2RTlLc1cK",
      "endpoints": [
        "https://github.com/ZamIzzudin/Yuika-Desktop/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  },
  "bundle": {
    "createUpdaterArtifacts": true,
    "active": true,
    "resources": {
      "../../../dist/desktop": "engine/"
    },
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "languages": ["English"],
        "displayLanguageSelector": false
      }
    }
  }
}
