{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Yuika desktop main window: welcome/onboarding + app UI (dev origin is the web dev server).",
  "local": true,
  "windows": ["main"],
  "remote": {
    "urls": [
      "http://localhost:*",
      "http://127.0.0.1:*",
      "http://tauri.localhost",
      "https://tauri.localhost"
    ]
  },
  "permissions": [
    "core:default",
    "allow-pick-host",
    "allow-pick-remote",
    "allow-get-last-setup",
    "allow-clear-last-setup"
  ]
}
